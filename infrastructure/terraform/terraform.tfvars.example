aws_region = "eu-central-1"
project = "gloomi"
environment = "dev"
web_origin = "https://app.example.com"
api_hostname = "api.example.com"
certificate_arn = "arn:aws:acm:eu-central-1:123456789012:certificate/replace-me"
api_image = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/gloomi-dev-api:0.1.0"
jwt_access_secret_arn = "arn:aws:secretsmanager:eu-central-1:123456789012:secret:gloomi/jwt-access-xxxxx"
jwt_refresh_secret_arn = "arn:aws:secretsmanager:eu-central-1:123456789012:secret:gloomi/jwt-refresh-xxxxx"
smtp_user_secret_arn = "arn:aws:secretsmanager:eu-central-1:123456789012:secret:gloomi/smtp-user-xxxxx"
smtp_password_secret_arn = "arn:aws:secretsmanager:eu-central-1:123456789012:secret:gloomi/smtp-password-xxxxx"
email_code_pepper_secret_arn = "arn:aws:secretsmanager:eu-central-1:123456789012:secret:gloomi/email-code-pepper-xxxxx"
smtp_from = "your.verified.address@gmail.com"
