{
  "name": "@gloomi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "build:worker": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude test/integration/**",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:migrations": "node scripts/run-migration-tests.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-secrets-manager": "^3.750.0",
    "@aws-sdk/s3-presigned-post": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "bullmq": "5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "5.4.2",
    "nodemailer": "^6.10.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "6.0.2",
    "pg": "8.13.1",
    "supertest": "7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
